{
  "name": "kupi-notification-service",
  "version": "1.0.0",
  "description": "Kupi Notification Service - Message Template Management and Notification Delivery",
  "main": "src/index.js",
  "scripts": {
    "dev": "serverless offline",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "deploy:qa": "serverless deploy --stage qa",
    "remove": "serverless remove",
    "logs": "serverless logs -f",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js"
  },
  "keywords": [
    "serverless",
    "aws",
    "lambda",
    "notification",
    "sms",
    "email",
    "push-notification",
    "whatsapp",
    "templates",
    "kupi"
  ],
  "author": "Kupi Development Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "aws-lambda": "^1.0.7",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "axios": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.5",
    "@aws-sdk/client-cognito-identity-provider": "^3.450.0",
    "@aws-sdk/client-sns": "^3.450.0",
    "@aws-sdk/client-ses": "^3.450.0",
    "validator": "^13.11.0",
    "uuid": "^9.0.1",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/validator": "^13.11.7",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.2",
    "esbuild": "^0.19.8",
    "serverless": "^3.38.0",
    "serverless-esbuild": "^1.51.0",
    "serverless-offline": "^13.3.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}